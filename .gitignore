# тайни (API ключ, парола за вход, refresh token) - виж config.py и .env.example
.env

# виртуална среда
venv/

# python кеш
__pycache__/
*.pyc

# кеширани модели (регенерират се от CSV-тата)
model_cache/

# бази данни (двоични, не се diff-ват смислено — има отделен db_backups/)
*.db
*.db-shm
*.db-wal

# данни (CSV/JSON, регенерират се нощно от API-то, твърде обемни за git)
*.csv
*.json

# логове и прогрес файлове
*.log
*.txt

# ⭐ ИЗКЛЮЧЕНИЕ (Партида 1, 21.08.2026): резултати от validation/ ГИ ВЛИЗАТ
# в git нарочно - те са доказателството зад преди/след твърдения, не
# регенерируеми данни. Виж validation/README.md.
!validation/*.csv
!validation/*.txt

# стари backup копия на живия файл, оставени от предишни патчове
*.bak*

# голям инсталатор, не е част от приложението
cloudflared.deb

# папки с исторически/backup данни
odds_historical/
db_backups/

# празни/случайни маркерни файлове
175
269
271
307
308
